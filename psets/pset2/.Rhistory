apply(delta_mat, 1, function(x) delta_ga(x, 0.5))
log_prob <- function(delta, a){
delta*log(a) + (1-delta)*log1p(-a) #log1p(-a) = log(1-a)
}
delta_ga <- function(delta_g, a){
delta_ga_mat <- cbind(delta_g, a)
delta_ga <- sum(apply(delta_ga_mat, 1, log_prob))
return(exp(delta_ga))
}
apply(delta_mat, 1, function(x) delta_ga(x, 0.5))
apply(delta_mat, 1, function(x) delta_ga(x, c(0.5,0.2,0.1)))
m <- c(.1, .1,.1)
