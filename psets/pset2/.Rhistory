## LSE for numerical stability
lse <- function(x) {
# Handle cases where all entries are -Inf
if (all(is.infinite(x) & x < 0)) return(-Inf)
# Find the maximum value to prevent overflow/underflow
max_x <- max(x, na.rm = TRUE)
# If max is Inf, return Inf
if (is.infinite(max_x)) return(max_x)
# Apply the log-sum-exp stabilization formula
max_x + log(sum(exp(x - max_x), na.rm = TRUE))
}
