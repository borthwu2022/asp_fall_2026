# 6. Visualization
hist(samples, breaks = 30, freq = FALSE,
col = "skyblue", border = "white",
main = "Accept-Reject Sampling: Standard Normal",
xlab = "x")
# Overlay true density
curve(dnorm(x), from = -4, to = 4,
col = "red", lwd = 2, add = TRUE)
legend("topright", legend = c("Histogram (samples)", "True Standard Normal density"),
col = c("skyblue", "red"), lwd = c(10, 2), bty = "n")
# Step 1: Enter the observed data
delta <- rbind(
c(0, 0, 0),
c(1, 0, 0),
c(0, 1, 0),
c(0, 0, 1),
c(1, 1, 1)
)
counts <- c(172738, 2030, 114, 68, 50)
n <- sum(counts)
K <- ncol(delta)
# Step 2: Initialize parameters
pi_hat <- 0.01
m_hat <- c(0.9, 0.9, 0.9)
u_hat <- c(0.01, 0.01, 0.01)
tol <- 1e-10
maxit <- 10000
# Step 3: EM iterations
for (iter in seq_len(maxit)) {
# E-step: conditional probabilities
# of each pattern under the two classes
prob_match <- apply(
delta, 1,
function(d) prod(m_hat^d * (1-m_hat)^(1-d))
)
prob_nonmatch <- apply(
delta, 1,
function(d) prod(u_hat^d * (1-u_hat)^(1-d))
)
# Posterior probability of matching
gamma <- pi_hat * prob_match /
(pi_hat * prob_match +
(1-pi_hat) * prob_nonmatch)
# M-step: weighted parameter updates
weighted_match <- counts * gamma
weighted_nonmatch <- counts * (1-gamma)
pi_new <- sum(weighted_match) / n
m_new <- colSums(
delta * weighted_match
) / sum(weighted_match)
u_new <- colSums(
delta * weighted_nonmatch
) / sum(weighted_nonmatch)
# Convergence criterion
change <- max(abs(
c(pi_new, m_new, u_new) -
c(pi_hat, m_hat, u_hat)
))
# Update parameters
pi_hat <- pi_new
m_hat <- m_new
u_hat <- u_new
if (change < tol) break
}
# Step 4: Recompute posterior match probabilities
# at the final parameter estimates
prob_match <- apply(
delta, 1,
function(d) prod(m_hat^d * (1-m_hat)^(1-d))
)
prob_nonmatch <- apply(
delta, 1,
function(d) prod(u_hat^d * (1-u_hat)^(1-d))
)
gamma <- pi_hat * prob_match /
(pi_hat * prob_match +
(1-pi_hat) * prob_nonmatch)
# Step 5: Display fitted estimates
cat("Iterations:", iter, "\n")
cat("pi:", pi_hat, "\n")
cat("m:", m_hat, "\n")
cat("u:", u_hat, "\n")
results <- data.frame(
delta1 = delta[, 1],
delta2 = delta[, 2],
delta3 = delta[, 3],
count = counts,
prob_match = gamma,
expected_matches = counts * gamma
)
print(results)
