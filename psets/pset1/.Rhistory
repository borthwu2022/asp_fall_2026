# Placeholders for simulated functions
results <- vector(mode = "list", length = 3)
# A vector of different sample sizes
n_samp <- c(100, 200, 1000)
results <- foreach(1:num_cores)%dopar%{
for (i in seq_along(n_samp)) {
# An evenly spaced grid of n values b/w (-2,2)
grid <- seq(-2, 2, length.out = n_samp[i])
# Compute the covariance kernel with jitter added for numerical stability
K <- rbf(grid, grid, sigma_2 = 1, l = 1) + 1e-8 * diag(n_samp[i])
L <- t(chol(K)) # Extract L matrix
# Draw five realizations of z vectors
Z <- matrix(rnorm(n_samp[i] * 5),
nrow = n_samp[i],
ncol = 5)
# Construct the five realizations of functions
f <- L %*% Z
matplot(grid, f,
type = "l",
lty = 1,main = paste("Sample Size:", n_samp[i]))
results[[i]] <- f
}
}
