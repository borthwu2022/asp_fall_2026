rm(list=ls())
library(MASS)
set.seed(123)
d <- 1000   # dimension of the multivariate normal
k <- 1000   # rank component
n <- 1000   # number of samples
## Construct covariance matrix
A <- matrix(rnorm(d * k), nrow = d, ncol = k)
Sigma <- A %*% t(A) + diag(1e-3, d)
mu <- rep(0, d)
start_mvrnorm <- Sys.time()
X_mvrnorm <- mvrnorm(
n = n,
mu = mu,
Sigma = Sigma
)
end_mvrnorm <- Sys.time()
time_mvrnorm <- end_mvrnorm - start_mvrnorm
start_chol <- Sys.time()
time_mvrnorm
start_chol <- Sys.time()
## R's chol() returns an upper-triangular matrix R such that
##
##     t(R) %*% R = Sigma
##
R <- chol(Sigma)
## Generate n independent N(0, I_d) vectors.
## Each row is one observation.
Z <- matrix(rnorm(n * d), nrow = n, ncol = d)
## If Z_i ~ N(0, I), then
##
##     Z_i %*% R ~ N(0, t(R) %*% R)
##               = N(0, Sigma)
##
X_chol <- Z %*% R
## Add the mean vector
X_chol <- sweep(X_chol, 2, mu, "+")
end_chol <- Sys.time()
time_chol <- end_chol - start_chol
time_chol
time_mvrnorm
start_chol <- Sys.time()
## R's chol() returns an upper-triangular matrix R such that
##
##     t(R) %*% R = Sigma
##
R <- chol(Sigma)
## Generate n independent N(0, I_d) vectors.
## Each row is one observation.
Z <- matrix(rnorm(n * d), nrow = n, ncol = d)
## If Z_i ~ N(0, I), then
##
##     Z_i %*% R ~ N(0, t(R) %*% R)
##               = N(0, Sigma)
##
X_chol <- Z %*% R
## Add the mean vector
X_chol <- sweep(X_chol, 2, mu, "+")
end_chol <- Sys.time()
time_chol <- end_chol - start_chol
time_chol
start_mvrnorm <- Sys.time()
X_mvrnorm <- mvrnorm(
n = n,
mu = mu,
Sigma = Sigma
) # Slow
end_mvrnorm <- Sys.time()
time_mvrnorm <- end_mvrnorm - start_mvrnorm
cat("MASS::mvrnorm time:\n")
print(time_mvrnorm)
cat("\nCholesky time:\n")
print(time_chol)
