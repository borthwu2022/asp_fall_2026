# Construct a for-loop function to calculate the column means
forcol_mean <- function(X){
if (!is.data.frame(X)) {
stop("X is not a data frame!")
}
if (!all(sapply(X, is.numeric))) {
stop("X has at least one non-numeric column!")
}
if(nrow(X) <1 | ncol(X) < 1){
stop("X has zero row or column!")
}
# Create an empty vector that will be used to store column means later
colmeans <- as.vector(rep(NA, ncol(X)))
names(colmeans) <- colnames(X)
for (i in 1:ncol(X)) {
colmeans[i] <- mean(X[,i])
}
return(colmeans)
}
