data("vdem")
force(vdem)
flag_backsliding <- function(df, score_var = "v2x_polyarchy") {
df <- df %>%
arrange(year) %>%
mutate(score = .data[[score_var]])
# Require a 1995 baseline
baseline_1995 <- df$score[df$year == 1995]
baseline_1995 <- if (length(baseline_1995) == 0) NA_real_ else baseline_1995[1]
n <- nrow(df)
# Initialize outputs
annual_change <- c(NA_real_, diff(df$score))
overall_decline_1995 <- baseline_1995 - df$score
eligible_1995 <- !is.na(baseline_1995) && baseline_1995 > 0.5
backsliding_episode <- integer(n)
episode_id <- integer(n)
# If not eligible in 1995, return zeros
if (!eligible_1995) {
return(df %>%
mutate(
baseline_1995 = baseline_1995,
eligible_1995 = 0L,
annual_change = annual_change,
overall_decline_1995 = overall_decline_1995,
backsliding_episode = 0L,
episode_id = 0L
) %>%
select(-score))
}
active <- FALSE
current_episode <- 0L
onset_idx <- NA_integer_
for (i in seq_len(n)) {
# Ignore pre-1995 years
if (df$year[i] < 1995) next
# Missing values break episodes
if (is.na(df$score[i]) || is.na(annual_change[i]) && df$year[i] > 1995) {
active <- FALSE
onset_idx <- NA_integer_
next
}
if (!active) {
# Episode onset
if (!is.na(annual_change[i]) &&
annual_change[i] <= -0.01 &&
overall_decline_1995[i] >= 0.1) {
active <- TRUE
current_episode <- current_episode + 1L
onset_idx <- i
backsliding_episode[i] <- 1L
episode_id[i] <- current_episode
}
} else {
# Trailing 5-year window (using annual changes indexed by year rows)
w_start <- max(onset_idx, i - 4)
w_idx <- w_start:i
# Rule (i): at least one annual decline <= -0.01 in each trailing 5-year window
has_negative_change <- any(annual_change[w_idx] <= -0.01, na.rm = TRUE)
# Rule (ii): no single-year positive reversal >= +0.03
big_positive_reversal <- !is.na(annual_change[i]) && annual_change[i] >= 0.03
# Rule (iii): no cumulative positive reversal >= +0.1 over trailing 5 years
cumulative_positive_reversal <- sum(pmax(annual_change[w_idx], 0), na.rm = TRUE) >= 0.1
if (has_negative_change && !big_positive_reversal && !cumulative_positive_reversal) {
backsliding_episode[i] <- 1L
episode_id[i] <- current_episode
} else {
active <- FALSE
onset_idx <- NA_integer_
}
}
}
df %>%
mutate(
baseline_1995 = baseline_1995,
eligible_1995 = 1L,
annual_change = annual_change,
overall_decline_1995 = overall_decline_1995,
backsliding_episode = backsliding_episode,
episode_id = episode_id
) %>%
select(-score)
}
vdem_sub <- vdem |>
filter(year >= 1991) |>
mutate(country = country_text_id)
# Apply country by country
vdem_backsliding <- vdem_sub %>%
arrange(country, year) %>%
group_by(country) %>%
group_modify(~ flag_backsliding(.x, score_var = "v2x_polyarchy")) %>%
ungroup()
covars <- c("country","year","baseline_1995",
"eligible_1995",
"annual_change",
"v2x_polyarchy",
"overall_decline_1995",
"backsliding_episode",
"episode_id")
backsliders2 <- vdem_backsliding |>
select(all_of(covars))
View(backsliders2)
