# Bubble sort
bubble <- function(x){
if (!is.vector(x) | !is.numeric(x)) {
stop("This is not a numeric vector!")
}
n <- length(x)
for (i in seq_len(n - 1)) {
for (j in seq_len(n - i)) {
if (x[j] > x[j + 1]) {
temp <- x[j]
x[j] <- x[j + 1]
x[j + 1] <- temp
}
}
}
}
# Bubble sort
bubble <- function(x){
if (!is.vector(x) | !is.numeric(x)) {
stop("This is not a numeric vector!")
}
n <- length(x)
for (i in seq_len(n - 1)) {
for (j in seq_len(n - i)) {
if (x[j] > x[j + 1]) {
temp <- x[j]
x[j] <- x[j + 1]
x[j + 1] <- temp
}
}
}
return(x)
}
